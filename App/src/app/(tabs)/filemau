    <script>
        (function initLoginPage() {
          const passwordInput = document.getElementById('passwordInput');
          const togglePasswordBtn = document.getElementById('togglePasswordBtn');
          const togglePasswordIcon = document.getElementById('togglePasswordIcon');

          const btnStateDefault = document.getElementById('btnStateDefault');
          const btnStateError = document.getElementById('btnStateError');
          const btnStateLoading = document.getElementById('btnStateLoading');
          const statusText = document.getElementById('currentStatusText');

          const errorAlert = document.getElementById('errorAlert');
          const btnLogin = document.getElementById('btnLogin');
          const loginText = document.getElementById('loginText');
          const loginIcon = document.getElementById('loginIcon');
          const loginSpinner = document.getElementById('loginSpinner');

          // Toggle password reveal
          if (togglePasswordBtn && passwordInput && togglePasswordIcon) {
            togglePasswordBtn.addEventListener('click', () => {
              const isPassword = passwordInput.getAttribute('type') === 'password';
              passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
              togglePasswordIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
            });
          }

          // UX Preview State Handler
          function setActiveState(state) {
            // Reset buttons style
            [btnStateDefault, btnStateError, btnStateLoading].forEach(btn => {
              btn.classList.remove('bg-surface-container-lowest', 'shadow-sm', 'text-primary');
              btn.classList.add('bg-transparent', 'text-on-surface-variant');
            });

            if (state === 'default') {
              btnStateDefault.classList.add('bg-surface-container-lowest', 'shadow-sm', 'text-primary');
              btnStateDefault.classList.remove('bg-transparent', 'text-on-surface-variant');
              errorAlert.classList.add('hidden');
              loginText.textContent = 'Đăng nhập';
              loginIcon.classList.remove('hidden');
              loginSpinner.classList.add('hidden');
              btnLogin.removeAttribute('disabled');
              statusText.textContent = 'Mặc định';
            } else if (state === 'error') {
              btnStateError.classList.add('bg-surface-container-lowest', 'shadow-sm', 'text-primary');
              btnStateError.classList.remove('bg-transparent', 'text-on-surface-variant');
              errorAlert.classList.remove('hidden');
              loginText.textContent = 'Đăng nhập';
              loginIcon.classList.remove('hidden');
              loginSpinner.classList.add('hidden');
              btnLogin.removeAttribute('disabled');
              statusText.textContent = 'Báo lỗi';
            } else if (state === 'loading') {
              btnStateLoading.classList.add('bg-surface-container-lowest', 'shadow-sm', 'text-primary');
              btnStateLoading.classList.remove('bg-transparent', 'text-on-surface-variant');
              errorAlert.classList.add('hidden');
              loginText.textContent = 'Đang xác thực...';
              loginIcon.classList.add('hidden');
              loginSpinner.classList.remove('hidden');
              btnLogin.setAttribute('disabled', 'true');
              statusText.textContent = 'Đang xử lý';
            }
          }

          btnStateDefault.addEventListener('click', () => setActiveState('default'));
          btnStateError.addEventListener('click', () => setActiveState('error'));
          btnStateLoading.addEventListener('click', () => setActiveState('loading'));

          // Interactive Submit
          btnLogin.addEventListener('click', () => {
            setActiveState('loading');
            setTimeout(() => {
              setActiveState('default');
            }, 1500);
          });
        })();
    </script>
  </main>
</body>

</html>