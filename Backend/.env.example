# Sao chép file này thành .env và điền giá trị thật.
# File .env KHÔNG được commit (đã nằm trong .gitignore).

# JWT secret — bắt buộc đổi ở production, tối thiểu 32 ký tự
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes

# Mật khẩu MySQL root (khớp với docker-compose.yml)
DB_PASSWORD=root
